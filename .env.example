NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# api | worker | all
# Production Compose runs separate `api` and `worker` services — do not set `all` on both.
PROCESS_MODE=all

# fcm = Firebase Messaging (required for production workers).
# noop = dry-run; forbidden when NODE_ENV=production and PROCESS_MODE includes worker.
DELIVERY_MODE=fcm

# MongoDB (Compose internal hostname is `mongo`; do not publish 27017 publicly in prod)
MONGODB_URI=mongodb://127.0.0.1:27017/care_circle

# Firebase Admin — mount/inject at runtime; never bake into the Docker image
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Notification timing (approved C5)
MISS_GRACE_MINUTES=0

# --- P2 circle-create tokens (trusted issuer ↔ API only; never ship to Flutter) ---
# CIRCLE_CREATE_TOKEN_SECRET=replace-with-long-random-secret-min-32-chars
CIRCLE_CREATE_TOKEN_MAX_TTL_SECONDS=600
# Keep false until a Cloud Function (or equivalent) proves circleId + ownerUid and mints tokens
CIRCLE_BOOTSTRAP_ENABLED=false

# Trusted HTTP issuer (POST /v1/internal/circle-create-tokens) — ops / Cloud Function only
CIRCLE_TOKEN_ISSUER_ENABLED=false
# CIRCLE_TOKEN_ISSUER_API_KEY=replace-with-long-random-api-key-min-32-chars

# Member invite tokens (HMAC uses CIRCLE_CREATE_TOKEN_SECRET; typed as circle_invite)
CIRCLE_INVITE_TOKEN_MAX_TTL_SECONDS=604800

# Optional Compose host mappings
# API_HOST_PORT=3000
# FIREBASE_SERVICE_ACCOUNT_HOST_PATH=./firebase-service-account.json
