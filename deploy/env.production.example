NODE_ENV=production
PORT=1001
LOG_LEVEL=info

PROCESS_MODE=all
DELIVERY_MODE=fcm

MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/care_circle?retryWrites=true&w=majority

FIREBASE_PROJECT_ID=care-circle-6a43b
FIREBASE_SERVICE_ACCOUNT_PATH=/var/www/care-circle-reminder/secrets/firebase-service-account.json

MISS_GRACE_MINUTES=0

# CIRCLE_CREATE_TOKEN_SECRET=replace-with-long-random-secret-min-32-chars
CIRCLE_CREATE_TOKEN_MAX_TTL_SECONDS=600
CIRCLE_BOOTSTRAP_ENABLED=false
CIRCLE_TOKEN_ISSUER_ENABLED=false
# CIRCLE_TOKEN_ISSUER_API_KEY=replace-with-long-random-api-key-min-32-chars
CIRCLE_INVITE_TOKEN_MAX_TTL_SECONDS=604800

PUBLIC_BASE_URL=https://carecircle.smartremindersapp.com
CERTBOT_EMAIL=ops@smartremindersapp.com
DOMAIN=carecircle.smartremindersapp.com
