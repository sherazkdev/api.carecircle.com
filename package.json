    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "mongodb-memory-server": "^10.2.3",
    "prettier": "^3.6.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
